# CloudSee Drive MCP server — configuration template.
# Copy to `.env` for local development (`.env` is gitignored — never commit real creds).
# In Claude Desktop, set these under the server's "env" block instead (see README).

# Your CloudSee Drive API key id (looks like AKIA...). Required.
CLOUDSEE_API_KEY_ID=your-api-key-id

# The matching API key secret. Required. NEVER commit the real value.
CLOUDSEE_API_KEY_SECRET=your-api-key-secret

# API base URL. Optional — defaults to https://drive-api.cloudsee.cloud (production).
# UAT:  https://drive-api-uat.cloudsee.cloud
# CLOUDSEE_API_BASE_URL=https://drive-api.cloudsee.cloud

# Optional default drive (S3 bucket) used when a tool call omits `bucketName`.
# Find the drive name in the CloudSee dashboard. If unset, every drive-scoped tool
# (browse_folder, search_files, list_files, get_file_metadata, download_file, the write
# tools, …) requires a `bucketName` argument.
# CLOUDSEE_DEFAULT_BUCKET=your-drive-name

# Optional log level: error | warn | info | debug (default: info). Logs go to stderr only.
# CLOUDSEE_LOG_LEVEL=info

# Optional request timeout in milliseconds (default: 30000).
# CLOUDSEE_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# HOSTED / REMOTE transport (Lambda deploy via SAM, or `npm run start:http` locally).
# These are NOT used by the local stdio server above; they configure the
# multi-tenant HTTP server, which authenticates callers via OAuth
# instead of a baked-in API key.
# ---------------------------------------------------------------------------

# Public https origin of THIS server (advertised in OAuth protected-resource metadata). Required.
# MCP_PUBLIC_URL=https://drive-mcp-uat.cloudsee.cloud

# The CloudSee Drive OAuth authorization-server issuer base. Required.
#   UAT: https://drive-oauth-uat.cloudsee.cloud   Production: https://drive-oauth.cloudsee.cloud
# CLOUDSEE_OAUTH_ISSUER=https://drive-oauth-uat.cloudsee.cloud

# NOTE: the hosted server holds NO API key/secret. Each caller's credential arrives in
# their OAuth access token and is used per-request (X-Api-Key == ApiKeyId, per user).

# The /v1 data-plane base URL — a DISTINCT host from the OAuth issuer (drive-api*, not drive-oauth*).
# Defaults to the PRODUCTION drive-api host, so SET IT EXPLICITLY for non-prod stages.
#   UAT: https://drive-api-uat.cloudsee.cloud   Production: https://drive-api.cloudsee.cloud
# CLOUDSEE_API_BASE_URL=https://drive-api-uat.cloudsee.cloud

# Optional listen port for the local HTTP dev server (default: 3000). Unused on Lambda.
# PORT=3000
